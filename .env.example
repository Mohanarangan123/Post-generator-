# ---------------------------------------------------------
# Environment configuration for LinkedIn Content Generator
# Copy this file to ".env" and adjust values as needed.
# ---------------------------------------------------------

# PostgreSQL connection string used by the backend (SQLAlchemy)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/linkedin_ai


# Ollama local LLM server configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=300

# Backend URL used by the Streamlit frontend
BACKEND_URL=http://localhost:8000

# Postgres credentials used by docker-compose.yml
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=linkedin_aidocker compose ps
POSTGRES_PORT=5432

# --- Image Generation ---
# Provider: "mock" (no API key needed) or "huggingface" (requires HF_TOKEN)
IMAGE_PROVIDER=mock

# Hugging Face API token (required only when IMAGE_PROVIDER=huggingface)
HF_TOKEN=

# Hugging Face image model to use
HF_IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0

# Local directory where generated PNG infographics are saved
IMAGE_OUTPUT_DIR=images
