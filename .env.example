# ---------------------------------------------------------
# Environment configuration for LinkedIn Content Generator
# Copy this file to ".env" and adjust values as needed.
# ---------------------------------------------------------

# PostgreSQL connection string used by the backend (SQLAlchemy)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/linkedin_ai


# Ollama local LLM server configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=300

# Backend URL used by the Streamlit frontend
BACKEND_URL=http://localhost:8000

# Postgres credentials used by docker-compose.yml
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=linkedin_ai
POSTGRES_PORT=5433

# ---------------------------------------------------------
# Phase 4: Cloudflare Workers AI - Infographic Generation
# ---------------------------------------------------------
# Cloudflare account and API token for Workers AI image generation
# Get your account ID from: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Model and settings for image generation
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-9b
CLOUDFLARE_IMAGE_WIDTH=1536
CLOUDFLARE_IMAGE_HEIGHT=864
CLOUDFLARE_IMAGE_TIMEOUT_SECONDS=120
CLOUDFLARE_IMAGE_MAX_RETRIES=2

# Output directory for generated infographics
INFOGRAPHIC_OUTPUT_DIR=outputs/infographics
